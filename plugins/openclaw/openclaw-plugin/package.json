{
  "name": "@mammothmail/openclaw",
  "version": "0.1.0",
  "description": "Mammoth Mail email connector for OpenClaw",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./setup-entry.js": "./dist/setup-entry.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "openclaw": "2026.10.10",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "npm": "12.2.1",
    "undici": "^8.12.2",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.7"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "compat": {
      "pluginApi": ">=2026.9.7",
      "minGatewayVersion": "2026.9.7"
    },
    "build": {
      "openclawVersion": "2026.9.7",
      "pluginSdkVersion": "2026.9.7"
    },
    "channel": {
      "id": "mammothmail",
      "label": "Mammoth Mail",
      "selectionLabel": "Mammoth Mail (email)",
      "detailLabel": "Mammoth Mail inbox",
      "docsPath": "/channels/mammothmail",
      "blurb": "Give your agent its own email inbox through Mammoth Mail.",
      "markdownCapable": false,
      "order": 60,
      "setup": {
        "fields": [
          {
            "key": "code",
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--code <url-or-code>",
              "description": "Mammoth Mail one-time setup URL or code"
            }
          },
          {
            "key": "baseUrl",
            "kind": "string",
            "cli": {
              "flags": "--base-url <url>",
              "description": "Mammoth Mail base URL"
            }
          },
          {
            "key": "gatewayId",
            "kind": "string",
            "cli": {
              "flags": "--gateway-id <id>",
              "description": "Mammoth Mail connector gateway id (manual setup)"
            }
          },
          {
            "key": "secret",
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--secret <secret>",
              "description": "Mammoth Mail relay secret (manual setup)"
            }
          }
        ]
      }
    }
  }
}
